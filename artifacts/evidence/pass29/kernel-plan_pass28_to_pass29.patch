+            id: LayoutId(981),
+            family: LayoutFamily::Columnar,
+        };
+        let query = RelExpr::JoinEq {
+            left: Box::new(RelExpr::Scan(left)),
+            right: Box::new(RelExpr::Scan(right)),
+            left_column: 0,
+            right_column: 0,
+            equivalence,
+        };
+        let mut model = kernel_model::FiniteModel::default();
+        model
+            .relations
+            .insert(left, vec![vec![Value::I64(1)], vec![Value::I64(2)]]);
+        model
+            .relations
+            .insert(right, vec![vec![Value::I64(1)], vec![Value::I64(2)]]);
+        let mut maintained =
+            MaterializedRelPlanState::build(&query, &model, &context, &registry).unwrap();
+        let mut store = PhysicalStore::default();
+        store
+            .install(
+                left,
+                left_binding,
+                NativeRelation::typed_columnar(vec![NativeColumn::I64(vec![1, 2])]).unwrap(),
+            )
+            .unwrap();
+        store
+            .install(
+                right,
+                right_binding,
+                NativeRelation::typed_columnar(vec![NativeColumn::I64(vec![1, 2])]).unwrap(),
+            )
+            .unwrap();
+        maintained
+            .attach_storage_handles(
+                left,
+                &store.logical_row_handles(left, left_binding).unwrap(),
+            )
+            .unwrap();
+        maintained
+            .attach_storage_handles(
+                right,
+                &store.logical_row_handles(right, right_binding).unwrap(),
+            )
+            .unwrap();
+        let runtime =
+            RuntimeRevisionBundle::new(RevisionId::new(revision), store, maintained).unwrap();
+        (
+            context,
+            registry,
+            left,
+            right,
+            left_binding,
+            right_binding,
+            query,
+            runtime,
+        )
+    }

+    #[test]
+    fn hostile_bootstrap_semantic_bag_reordering_breaks_storage_handle_alignment() {
+        let (context, registry, relation) = planning_context();
+        let binding = LayoutBinding {
+            id: LayoutId(4242),
+            family: LayoutFamily::Columnar,
+        };
+
+        // Logical authority and physical storage are semantically equal bags,
+        // but intentionally use different row order.
+        let mut model = kernel_model::FiniteModel::default();
+        model.relations.insert(
+            relation,
+            vec![vec![Value::I64(1)], vec![Value::I64(2)]],
+        );
+        let revision = kernel_revision::Revision::build(
+            RevisionId::new(500),
+            &context,
+            &registry,
+            kernel_model::DatabaseState {
+                model,
+                ..kernel_model::DatabaseState::default()
+            },
+        )
+        .unwrap();
+
+        let mut store = PhysicalStore::default();
+        store
+            .install(
+                relation,
+                binding,
+                NativeRelation::typed_columnar(vec![NativeColumn::I64(vec![2, 1])]).unwrap(),
+            )
+            .unwrap();
+
+        let runtime = RuntimeRevisionBundle::build(
+            revision,
+            store,
+            BTreeMap::from([(relation, binding)]),
+            &[RuntimeMaterializationSpec {
+                id: test_materialization_id(),
+                query: RelExpr::Scan(relation),
+            }],
+            &registry,
+        )
+        .expect("semantically equal bag bootstrap is currently accepted");
+
+        let delta = scan_delta(relation, &[], &[2], &context, &registry);
+        let mutations = [RevisionRelationMutation {
+            relation,
+            delta: &delta,
+        }];
+        let cell = RuntimeRevisionCell::new(runtime);
+        let prepared = prepare_runtime_cell_revision(&cell, 501, &mutations, &registry).unwrap();
+        let _ = prepared.seal(&cell).unwrap().publish();
+        let after = cell.snapshot().unwrap();
+
+        let logical = after.revision().state().model.relations[&relation]
+            .iter()
+            .map(|row| match row.as_slice() {
+                [Value::I64(v)] => *v,
+                _ => unreachable!(),
+            })
+            .collect::<Vec<_>>();
+        let maintained = runtime_maintained_i64_values(&after, &context, &registry);
+        assert_eq!(maintained, logical, "published maintained state diverged from authoritative revision");
+    }
+

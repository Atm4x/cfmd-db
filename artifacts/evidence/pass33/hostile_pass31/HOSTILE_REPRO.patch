+    #[test]
+    fn hostile_forged_resolved_handle_payload_mismatch_must_be_rejected() {
+        let (context, registry, text_eq, relation, _) = setup();
+        let i64_eq = SemanticId::new(101);
+        let mut model = FiniteModel::default();
+        let alpha = vec![Value::Text("Alpha".into()), Value::I64(1)];
+        let beta = vec![Value::Text("Beta".into()), Value::I64(2)];
+        model.relations.insert(relation, vec![alpha.clone(), beta.clone()]);
+
+        let query = RelExpr::Distinct {
+            input: Box::new(RelExpr::Scan(relation)),
+            column_equivalences: vec![text_eq, i64_eq],
+        };
+        let mut state = MaterializedRelPlanState::build(&query, &model, &context, &registry).unwrap();
+        state.attach_storage_handles(
+            relation,
+            &[
+                kernel_types::StableRowHandle { slot: 0, generation: 0 },
+                kernel_types::StableRowHandle { slot: 1, generation: 0 },
+            ],
+        ).unwrap();
+
+        // Forgery: payload says "remove Beta", but handle selects Alpha.
+        let delta = RelationDelta {
+            inserted: Vec::new(),
+            removed: vec![beta.clone()],
+            result_type: RelExpr::Scan(relation).typecheck(&context, &registry).unwrap(),
+        };
+        let forged = StorageResolvedRelationDelta::from_parts(
+            relation,
+            delta,
+            vec![kernel_types::StableRowHandle { slot: 0, generation: 0 }],
+            Vec::new(),
+        );
+        let map = BTreeMap::from([(relation, forged)]);
+
+        let result = state.apply_storage_resolved_deltas(&map, &context, &registry);
+        assert!(result.is_err(), "forged handle/payload association was accepted: {result:?}");
+    }
+

+/// Correctness-first storage prepare result. The retained source snapshot makes
+/// freshness exact even for two different stores with equal epoch/revision counters.
+#[derive(Debug, PartialEq, Eq)]
+struct PreparedPhysicalStoreTransition {
+    source_epoch: u64,
+    source_revision: Option<RevisionId>,
+    source_state: Box<PhysicalStore>,
+    candidate: Box<PhysicalStore>,
+    certified_delta: StorageCertifiedRelationDelta,
+}
+
+impl PreparedPhysicalStoreTransition {
+    #[must_use]
+    fn certified_delta(&self) -> &StorageCertifiedRelationDelta {
+        &self.certified_delta
+    }
+
+    fn into_candidate_if_current(
+        self,
+        current: &PhysicalStore,
+    ) -> Result<(PhysicalStore, StorageCertifiedRelationDelta), PhysicalExecutionError> {
+        if !current.can_commit_prepared(&self) {
+            return Err(PhysicalExecutionError::StalePreparedTransition);
+        }
+        Ok((*self.candidate, self.certified_delta))
+    }
+}
+
+/// One revision transition prepared across authoritative physical storage and
+/// reconstructible maintained query state. Live state is untouched until commit.
+#[derive(Debug, PartialEq, Eq)]
+pub struct PreparedStoragePlanTransition {
+    source_revision: RevisionId,
+    target_revision: RevisionId,
+    storage: PreparedPhysicalStoreTransition,
+    plan: PreparedMaterializedRelPlanTransition,
+}
+
+impl PreparedStoragePlanTransition {
+    #[must_use]
+    pub const fn source_revision(&self) -> RevisionId {
+        self.source_revision
+    }
+
+    #[must_use]
+    pub const fn target_revision(&self) -> RevisionId {
+        self.target_revision
+    }
+
+    #[must_use]
+    pub fn output_delta(&self) -> &RelationDelta {
+        self.plan.output_delta()
+    }
+
+    /// Jointly validates freshness before mutating either live participant.
+    /// Once both checks pass, the two state swaps are infallible.
+    pub fn commit(
+        self,
+        store: &mut PhysicalStore,
+        plan: &mut MaterializedRelPlanState,
+    ) -> Result<RelationDelta, PhysicalExecutionError> {
+        let PreparedStoragePlanTransition { storage, plan: prepared_plan, .. } = self;
+        let (storage_candidate, _) = storage.into_candidate_if_current(store)?;
+        let (plan_candidate, output_delta) = prepared_plan.into_candidate_if_current(plan)?;
+        *store = storage_candidate;
+        *plan = plan_candidate;
+        Ok(output_delta)
+    }
 }
 

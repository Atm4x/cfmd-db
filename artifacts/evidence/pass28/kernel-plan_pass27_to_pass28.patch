+pub fn prepare_storage_plan_transition(
+    store: &PhysicalStore,
+    plan: &MaterializedRelPlanState,
+    source_revision: RevisionId,
+    target_revision: RevisionId,
+    relation: SemanticId,
+    layout: LayoutBinding,
+    delta: &RelationDelta,
+    context: &kernel_schema::SemanticContext,
+    registry: &kernel_semantics::SemanticRegistry,
+) -> Result<PreparedStoragePlanTransition, PhysicalExecutionError> {
+    if source_revision == target_revision {
+        return Err(PhysicalExecutionError::InvalidRevisionTransition);
+    }
+    if store.revision() != Some(source_revision) || plan.revision() != Some(source_revision) {
+        return Err(PhysicalExecutionError::RevisionBindingMismatch);
+    }
+    let storage = store.prepare_relation_delta_certified_for_revision(
+        source_revision,
+        target_revision,
+        relation,
+        layout,
+        delta,
+        context,
+        registry,
+    )?;
+    let mut certified = BTreeMap::new();
+    certified.insert(relation, storage.certified_delta().clone());
+    let plan = plan.prepare_storage_certified_deltas_for_revision(
+        source_revision,
+        target_revision,
+        &certified,
+        context,
+        registry,
+    )?;
+    Ok(PreparedStoragePlanTransition {
+        source_revision,
+        target_revision,
+        storage,
+        plan,
+    })
+}

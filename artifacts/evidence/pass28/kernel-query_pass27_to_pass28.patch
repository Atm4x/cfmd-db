+/// Correctness-first prepared maintained-plan transition.
+///
+/// The full source snapshot is retained intentionally so commit freshness is an
+/// exact state check rather than an epoch-only heuristic. A later implementation
+/// may replace this clone with a collision-resistant state/version identity.
+#[derive(Debug, PartialEq, Eq)]
+pub struct PreparedMaterializedRelPlanTransition {
+    source_epoch: u64,
+    source_revision: Option<kernel_types::RevisionId>,
+    source_state: Box<MaterializedRelPlanState>,
+    candidate: Box<MaterializedRelPlanState>,
+    output_delta: RelationDelta,
+}
+
+impl PreparedMaterializedRelPlanTransition {
+    #[must_use]
+    pub fn output_delta(&self) -> &RelationDelta {
+        &self.output_delta
+    }
+
+    pub fn into_candidate_if_current(
+        self,
+        current: &MaterializedRelPlanState,
+    ) -> Result<(MaterializedRelPlanState, RelationDelta), RelQueryError> {
+        if !current.can_commit_prepared(&self) {
+            return Err(RelQueryError::StalePreparedTransition);
+        }
+        Ok((*self.candidate, self.output_delta))
+    }
 }
 
